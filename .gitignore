# --- secrets and local environment: never committed ---
.env
.env.*
!.env.example
secrets/*
!secrets/.gitkeep

# --- local interpreters / caches ---
.venv/
.venv-run/
__pycache__/
*.pyc
.pytest_cache/

# pytest's base temp lives inside the repository (see pyproject.toml)
runs/_pytest_tmp/

# --- live-run logs that are regenerated, not evidence ---
# (deliberately narrow: `runs/apt_lab/**` IS committed -- the raw traces are the
#  evidence behind every number in docs/, and a freeze without them is a claim.)
